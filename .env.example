# --- Serveur de jeu (Node/Socket.IO) — secrets JAMAIS côté front ---
PORT=8787
HOST=0.0.0.0
NODE_ENV=production
GAME_JWT_SECRET=change-me-32+chars-random
SUPABASE_URL=https://<projet>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role>          # serveur uniquement — jamais dans le bundle front
SUPABASE_JWKS_URL=https://<projet>.supabase.co/auth/v1/.well-known/jwks.json
CORS_ORIGINS=https://ton-domaine.fr,https://<serveur-de-jeu>
CLIENT_DIST=dist
MAX_PLAYERS_PER_ROOM=1000
ROOM_IDLE_TTL_MS=14400000

# --- Front (Vite) — variables PUBLIQUES (préfixe VITE_) ---
VITE_SUPABASE_URL=https://<projet>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon_key>                 # public, protégé par RLS
VITE_GAME_WS_URL=https://<serveur-de-jeu>          # URL WebSocket (optionnel : même origine par défaut)
