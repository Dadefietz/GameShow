# Configuration serveur — copier vers .env et remplir. AUCUNE vraie valeur ici.

# Serveur de jeu
PORT=8787
HOST=0.0.0.0
GAME_JWT_SECRET=              # OBLIGATOIRE en prod — longue chaîne aléatoire (openssl rand -hex 32)
CORS_ORIGINS=http://localhost:5173,http://localhost:8787
CLIENT_DIST=dist
DATA_DIR=data

# Animateurs autorisés (verrou de la page /host et des bibliothèques)
HOST_EMAIL=                   # emails Supabase séparés par des virgules ; vide = mode dev ouvert
                              # chaque animateur a sa PROPRE bibliothèque (data/owners/<id>.json)

# Supabase (serveur uniquement — jamais dans le bundle front)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=    # service_role : serveur SEULEMENT, jamais commitée
SUPABASE_JWKS_URL=            # https://<projet>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=          # alternative HS256 au JWKS (projets legacy)

# Front (préfixe VITE_ = embarqué dans le bundle — anon key uniquement, RLS protège)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
