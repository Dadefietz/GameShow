{
  "color": {
    "$type": "color",
    "primary": {
      "100": { "$value": "oklch(0.95 0.051 58)" },
      "200": { "$value": "oklch(0.88 0.085 58)" },
      "300": { "$value": "oklch(0.79 0.122 58)" },
      "400": { "$value": "oklch(0.70 0.153 58)" },
      "500": { "$value": "oklch(0.62 0.170 58)" },
      "600": { "$value": "oklch(0.53 0.170 58)" },
      "700": { "$value": "oklch(0.44 0.150 58)" },
      "800": { "$value": "oklch(0.35 0.122 58)" },
      "900": { "$value": "oklch(0.26 0.094 58)" }
    },
    "neutral": {
      "100": { "$value": "oklch(0.95 0.005 80)" },
      "200": { "$value": "oklch(0.88 0.008 80)" },
      "300": { "$value": "oklch(0.79 0.012 80)" },
      "400": { "$value": "oklch(0.70 0.014 80)" },
      "500": { "$value": "oklch(0.62 0.016 80)" },
      "600": { "$value": "oklch(0.53 0.016 80)" },
      "700": { "$value": "oklch(0.44 0.014 80)" },
      "800": { "$value": "oklch(0.35 0.012 80)" },
      "900": { "$value": "oklch(0.26 0.009 80)" },
      "950": { "$value": "oklch(0.20 0.008 80)" }
    },
    "forest": {
      "300": { "$value": "oklch(0.80 0.13 150)" },
      "500": { "$value": "oklch(0.70 0.14 150)" },
      "600": { "$value": "oklch(0.55 0.12 150)" }
    },
    "flame": {
      "bright": { "$value": "oklch(0.80 0.15 65)" }
    },
    "ink": { "$value": "oklch(0.22 0.03 55)" },
    "cream": { "$value": "oklch(0.97 0.02 85)" },
    "success": { "500": { "$value": "oklch(0.66 0.15 150)" } },
    "warning": { "500": { "$value": "oklch(0.82 0.16 88)" } },
    "danger":  { "500": { "$value": "oklch(0.66 0.21 28)" } },
    "info":    { "500": { "$value": "oklch(0.66 0.10 235)" } }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Fraunces", "Georgia", "serif"] },
      "text":    { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "black": { "$value": 900 }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.15 },
      "snug": { "$value": 1.3 },
      "normal": { "$value": 1.55 }
    },
    "size": {
      "$type": "dimension",
      "step--1": { "$value": "clamp(0.8333rem, 0.8072rem + 0.1159vw, 0.9rem)" },
      "step-0":  { "$value": "clamp(1rem, 0.9511rem + 0.2174vw, 1.125rem)" },
      "step-1":  { "$value": "clamp(1.2rem, 1.1193rem + 0.3587vw, 1.4063rem)" },
      "step-2":  { "$value": "clamp(1.44rem, 1.3156rem + 0.5527vw, 1.7578rem)" },
      "step-3":  { "$value": "clamp(1.728rem, 1.5444rem + 0.8161vw, 2.1973rem)" },
      "step-4":  { "$value": "clamp(2.0736rem, 1.8103rem + 1.1704vw, 2.7466rem)" },
      "step-5":  { "$value": "clamp(2.4883rem, 2.1186rem + 1.6433vw, 3.4332rem)" },
      "step-6":  { "$value": "clamp(2.986rem, 2.4751rem + 2.2705vw, 4.2915rem)" },
      "display-hero": { "$value": "clamp(6.375rem, 4.174rem + 9.783vw, 12rem)" }
    }
  },
  "size": {
    "$type": "dimension",
    "space": {
      "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" },
      "4": { "$value": "16px" }, "5": { "$value": "24px" }, "6": { "$value": "32px" },
      "7": { "$value": "48px" }, "8": { "$value": "64px" }, "9": { "$value": "96px" }
    },
    "radius": {
      "sm": { "$value": "10px" }, "md": { "$value": "16px" },
      "lg": { "$value": "22px" }, "xl": { "$value": "28px" }, "full": { "$value": "9999px" }
    },
    "touch-min": { "$value": "44px" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "140ms" },
      "base": { "$value": "240ms" },
      "slow": { "$value": "320ms" },
      "reveal": { "$value": "600ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard":   { "$value": [0.4, 0, 0.2, 1] },
      "decelerate": { "$value": [0, 0, 0.2, 1] },
      "accelerate": { "$value": [0.4, 0, 1, 1] },
      "emphasized": { "$value": [0.2, 0, 0, 1] }
    }
  },
  "semantic": {
    "color": {
      "$type": "color",
      "bg": {
        "page":     { "$value": "{color.neutral.950}" },
        "surface":  { "$value": "oklch(0.26 0.018 80)" },
        "elevated": { "$value": "oklch(0.32 0.020 80)" }
      },
      "text": {
        "primary": {
          "$value": "{color.neutral.100}",
          "$extensions": { "contrast": [ { "against": "{semantic.color.bg.page}", "min": 7.0 } ] }
        },
        "secondary": {
          "$value": "{color.neutral.300}",
          "$extensions": { "contrast": [ { "against": "{semantic.color.bg.page}", "min": 4.5 } ] }
        },
        "on-fire": {
          "$value": "{color.ink}",
          "$extensions": { "contrast": [ { "against": "{color.primary.500}", "min": 4.5 } ] }
        }
      },
      "action": {
        "primary":    { "$value": "{color.primary.500}" },
        "secondary":  { "$value": "{color.forest.500}" },
        "on-forest": {
          "$value": "{color.ink}",
          "$extensions": { "contrast": [ { "against": "{color.forest.500}", "min": 4.5 } ] }
        }
      },
      "signature": {
        "$value": "{color.flame.bright}",
        "$extensions": { "contrast": [ { "against": "{semantic.color.bg.page}", "min": 3.0 } ] }
      },
      "heading": {
        "$value": "{color.forest.300}",
        "$extensions": { "contrast": [ { "against": "{semantic.color.bg.surface}", "min": 3.0 } ] }
      },
      "border": { "$value": "oklch(0.45 0.02 80 / 0.55)" },
      "status": {
        "success": { "$value": "{color.success.500}", "$extensions": { "contrast": [ { "against": "{semantic.color.bg.page}", "min": 4.5 } ] } },
        "warning": { "$value": "{color.warning.500}", "$extensions": { "contrast": [ { "against": "{semantic.color.bg.page}", "min": 4.5 } ] } },
        "danger":  { "$value": "{color.danger.500}",  "$extensions": { "contrast": [ { "against": "{semantic.color.bg.page}", "min": 4.5 } ] } },
        "info":    { "$value": "{color.info.500}",    "$extensions": { "contrast": [ { "against": "{semantic.color.bg.page}", "min": 4.5 } ] } }
      }
    }
  },
  "component": {
    "button": {
      "$type": "color",
      "bg":       { "$value": "{semantic.color.action.primary}" },
      "bg-hover": { "$value": "{color.primary.400}" },
      "text":     { "$value": "{semantic.color.text.on-fire}" }
    },
    "card": {
      "$type": "color",
      "bg":     { "$value": "{semantic.color.bg.surface}" },
      "border": { "$value": "{semantic.color.border}" }
    }
  }
}
