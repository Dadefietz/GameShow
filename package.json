{
  "name": "project-game-show",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Jeu télévisé interactif en livestream — serveur de jeu autoritaire (Node + Socket.IO) + front React/Vite.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "node --watch src/server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node src/server/index.js",
    "check:server": "node --check src/server/index.js",
    "lint:server": "for f in $(find src/server -name '*.js'); do node --check \"$f\" || exit 1; done",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "node tests/integration/game-loop.mjs",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/static": "^10.1.3",
    "@supabase/supabase-js": "^2.45.0",
    "fastify": "^5.12.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.7",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}