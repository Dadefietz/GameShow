{
  "name": "project-game-show",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Jeu télévisé interactif en livestream — serveur de jeu autoritaire (Node + Socket.IO) + front React/Vite.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "node --watch src/server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node src/server/index.js",
    "check:server": "node --check src/server/index.js",
    "lint:server": "for f in $(find src/server -name '*.js'); do node --check \"$f\" || exit 1; done"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "fastify": "^4.28.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.7",
    "zod": "^3.23.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0"
  }
}
